# Copy this to .env and fill in your values
# NEVER commit .env to git!
AVATAR_BRIDGE_API_KEY=your-secret-key-here
AVATAR_SAFE_MODE=true
OPENCLAW_TELEGRAM_ID=6394043863
PORT=9000

# --- Realtime full-duplex voice (OpenAI Realtime API) ---
# Set VOICE_MODE=realtime to route mic audio through OpenAI Realtime instead of
# SileroVad + Whisper + Coqui. Leave as "coqui" for the current pipeline.
VOICE_MODE=coqui
OPENAI_API_KEY=sk-...
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=marin

# SSH mode: set these to run openclaw on a remote VM via SSH (e.g. from WSL2)
# Leave OPENCLAW_SSH_HOST empty to run openclaw locally
OPENCLAW_SSH_HOST=10.0.0.253
OPENCLAW_SSH_USER=guillaume
OPENCLAW_SSH_KEY=/root/.ssh/id_ed25519
